# Copy this file to .env and fill in real values. Never commit .env.

# API Key for 511.org (https://511.org/open-data/token)
API_KEY=your_511_api_key_here

# SQLite database path (defaults to data/caltrain_lat_long.db if unset)
DB_PATH=

# Legacy PostgreSQL setting kept for reference (not used by the app)
DB_USER=postgres

# Application settings
DEBUG=False
LOG_LEVEL=INFO

# Path to GTFS static data (defaults to ./gtfs_data if unset)
GTFS_PATH=

# Prefect settings
PREFECT_API_URL=http://127.0.0.1:4200
PREFECT_API_KEY=
DATA_COLLECTION_INTERVAL=60
VISUALIZATION_UPDATE_INTERVAL=3600

# FastAPI / Dash settings
API_HOST=0.0.0.0
API_PORT=8000
DASH_PORT=8050
