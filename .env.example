# Copy this file to .env and fill in real values. Never commit .env.

# API Key for 511.org (https://511.org/open-data/token). Used by the collector
# container and the GTFS schedule check. 511 allows 60 requests/hour per key.
API_KEY=changeme

# SQLite database path (defaults to data/caltrain_lat_long.db if unset)
DB_PATH=

# Optional: a healthchecks.io-style URL pinged by scripts/check_freshness.py
# (on success, and <url>/fail when the collector has stopped writing).
HEALTHCHECK_URL=
